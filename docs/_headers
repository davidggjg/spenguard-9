# Security and caching headers.
# Read by Netlify and by Cloudflare Pages.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Content-Security-Policy: default-src 'none'; img-src 'self'; style-src 'self'; script-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

# CSS and JS are served from stable filenames, so they must stay
# revalidatable. An "immutable" year-long cache here previously left
# visitors on an old stylesheet while the HTML was already updated, which
# broke the layout until the cache expired.
/assets/style.css
  Cache-Control: public, max-age=600, must-revalidate

/assets/lang.js
  Cache-Control: public, max-age=600, must-revalidate

# Images never change under a given name.
/assets/screens/*
  Cache-Control: public, max-age=604800

/*.png
  Cache-Control: public, max-age=604800

/*.html
  Cache-Control: public, max-age=600
